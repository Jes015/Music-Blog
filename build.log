[7m1[0m const t="2025/12-08-2025/12-08-2025",a="posts",r={id:"1bfb7736-2b92-420c-b486-8ff28f40febc",title:"⭐ Mi colección de imágenes favorita 🌲",content:'Voy a guardar en un drive todas las imágenes que me gustan mucho. La mayor <a href="https://drive.google.com/drive/folders/1bVaksBc2BZuEcM4Uhv9siCV23YSo5nTQ?usp=sharing" target="_blank">Click para ver</a><br>Ayer nació una flor en mi patio, hoy murió. Me di cuenta de lo corta que es la vida y decidí guardar en internet las imágenes de esas flores que nunca volverás a ver, pero que fueron muy bonitas mientras estaban vivas.',publishDate:1755019811052,likes:1,publisher:{id:"j-oyola-baby-la-maravilla",collection:"publishers"},images:[new Proxy({src:"/_astro/album-de-fotos.CNUrcSFI.jpg",width:2296,height:4080,format:"jpg",orientation:6,fsPath:"/home/jes015/Music-Blog/src/content/posts/2025/12-08-2025/album-de-fotos.jpg"},{get(s,e,o){return e==="clone"?structuredClone(s):e==="fsPath"?"/home/jes015/Music-Blog/src/content/posts/2025/12-08-2025/album-de-fotos.jpg":(s[e]!==void 0&&globalThis.astroAsset&&globalThis.astroAsset?.referencedImages.add("/home/jes015/Music-Blog/src/content/posts/2025/12-08-2025/album-de-fotos.jpg"),s[e])}})],valor:!0},i={type:"data",filePath:"/home/jes015/Music-Blog/src/content/posts/2025/12-08-2025/12-08-2025.json",rawData:""};export{i as _internal,a as collection,r as data,t as id};

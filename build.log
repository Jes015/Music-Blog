[7m1[0m const t="2025/22-09-2025/22-09-2025",a="posts",n={id:"5cad750a-02f6-4ed3-9640-d4bd0bdd404e",title:"🌻 Una foto BoNiTA 🌻",content:"Hoy me di cuenta de muchas cosas, pero no las tomo a mal. Solo son cosas que tienes que aceptar y vivir sabiendo que eso va a pasar aunque no te siente bien. Entiende el problema, dale una solución y acepta esa realidad.",publishDate:1758590045316,likes:1,publisher:{id:"j-oyola-baby-la-maravilla",collection:"publishers"},images:[new Proxy({src:"/_astro/una-foto-bonita.uNv-sRHd.jpeg",width:720,height:1280,format:"jpg",fsPath:"/home/jes015/Music-Blog/src/content/posts/2025/22-09-2025/una-foto-bonita.jpeg"},{get(o,e,s){return e==="clone"?structuredClone(o):e==="fsPath"?"/home/jes015/Music-Blog/src/content/posts/2025/22-09-2025/una-foto-bonita.jpeg":(o[e]!==void 0&&globalThis.astroAsset&&globalThis.astroAsset?.referencedImages.add("/home/jes015/Music-Blog/src/content/posts/2025/22-09-2025/una-foto-bonita.jpeg"),o[e])}})],valor:!0},i={type:"data",filePath:"/home/jes015/Music-Blog/src/content/posts/2025/22-09-2025/22-09-2025.json",rawData:""};export{i as _internal,a as collection,n as data,t as id};

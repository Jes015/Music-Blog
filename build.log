[96mdist/_astro/12-19-2024-2.BRn3mjRT.js[0m:[93m1[0m:[93m2535[0m - [93mwarning[0m[90m ts(6133): [0m's' is declared but its value is never read.

[7m1[0m const a="2024/12-19-2024-2/12-19-2024-2",n="posts",r={id:"2507807b-aa7a-426c-843c-0ed28dbbbcbd",title:"Navidad 2024 😁😁😁",content:"Ayer no estaba de humor, asi que borré el post anterior y ahora lo hago mejor :).<br><br>Bueno, quiero decir que estoy contentísimo por como sueno en este album. Realmente siento que he progresado demasiado, el nuevo micrófono valió totalmente el esfuerzo.<br>Ahora, quiero hacer marketing digital. Google me cobra por view alrededor de 0.23 pesos a 0.44 pesos, tengo pensado en invertir 1.000 pesos por dia durante todos los meses, lo que haría que minimo 900 personas clickeen mi canción por mes y máximo 2000 personas clikeen mi canción por mes. Esto no significa mucho, pero digamos que las personas de 2000 o 900, 2 o 3 se interesen por el enigma (Lo sé, lo sé, mi nombre), estaría ganando al mes 1 o 2 oyentes que escuchen mis canciones. <br>Ahora, se que todo no va a ser tan fácil, estoy esperando a que Google me deje meter fondos a la cuenta porque ahora esos hptas creen que soy un musulman o un israeli que robó una tarjeta y la metió por allí. Yo no lo entiendo, por qué no me dejan meter dinero a la cuenta, que les pasa a esos hptas simios.<br>Por haberme descuidado, investigué mas y me di cuenta de que había una mejor opción, estan todas las redes sociales que te puedes imaginar, pronto voy a iniciar también invirtiendo mil pesitos por las otras todos los días. Yo solo voy a decir que vi a Dua Lipa y dije, le voy a sacar un album (Bromitaaaaa). Bueno, volviendo al tema, no te sorprendas si al terminar el año me va mejor que este año, me fue muy bien la verdad, la segunda foto del post lo muestra, lo que mas me dió views fue escribirle a personas por transformice que escucharan mi canción, eso me ayudó muchisisimo.",publishDate:1734638962605,likes:1,publisher:{id:"j-oyola-baby-la-maravilla",collection:"publishers"},images:[new Proxy({src:"/_astro/navidad.BJQA5f33.png",width:737,height:627,format:"png",fsPath:"/home/jes015/Music-Blog/src/content/posts/2024/12-19-2024-2/navidad.png"},{get(o,e,s){return e==="clone"?structuredClone(o):e==="fsPath"?"/home/jes015/Music-Blog/src/content/posts/2024/12-19-2024-2/navidad.png":(o[e]!==void 0&&globalThis.astroAsset&&globalThis.astroAsset?.referencedImages.add("/home/jes015/Music-Blog/src/content/posts/2024/12-19-2024-2/navidad.png"),o[e])}}),new Proxy({src:"/_astro/spotify-2024.BBenlgJ7.png",width:1080,height:1080,format:"png",fsPath:"/home/jes015/Music-Blog/src/content/posts/2024/12-19-2024-2/spotify-2024.png"},{get(o,e,s){return e==="clone"?structuredClone(o):e==="fsPath"?"/home/jes015/Music-Blog/src/content/posts/2024/12-19-2024-2/spotify-2024.png":(o[e]!==void 0&&globalThis.astroAsset&&globalThis.astroAsset?.referencedImages.add("/home/jes015/Music-Blog/src/content/posts/2024/12-19-2024-2/spotify-2024.png"),o[e])}})]},i={type:"data",filePath:"/home/jes015/Music-Blog/src/content/posts/2024/12-19-2024-2/12-19-2024-2.json",rawData:""};export{i as _internal,n as collection,r as data,a as id};

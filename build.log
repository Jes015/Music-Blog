log/src/content/posts/2024/12-19-2024-2/navidad.png"},{get(o,e,s){return e==="clone"?structuredClone(o):e==="fsPath"?"/home/jes015/Music-Blog/src/content/posts/2024/12-19-2024-2/navidad.png":(o[e]!==void 0&&globalThis.astroAsset&&globalThis.astroAsset?.referencedImages.add("/home/jes015/Music-Blog/src/content/posts/2024/12-19-2024-2/navidad.png"),o[e])}}),new Proxy({src:"/_astro/spotify-2024.BBenlgJ7.png",width:1080,height:1080,format:"png",fsPath:"/home/jes015/Music-Blog/src/content/posts/2024/12-19-2024-2/spotify-2024.png"},{get(o,e,s){return e==="clone"?structuredClone(o):e==="fsPath"?"/home/jes015/Music-Blog/src/content/posts/2024/12-19-2024-2/spotify-2024.png":(o[e]!==void 0&&globalThis.astroAsset&&globalThis.astroAsset?.referencedImages.add("/home/jes015/Music-Blog/src/content/posts/2024/12-19-2024-2/spotify-2024.png"),o[e])}})]},i={type:"data",filePath:"/home/jes015/Music-Blog/src/content/posts/2024/12-19-2024-2/12-19-2024-2.json",rawData:""};export{i as _internal,n as collection,r as data,a as id};

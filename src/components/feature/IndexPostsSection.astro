---
import { Post, PostSearch, PostFilter } from "@/components/feature"
import { SectionLayout } from "@/components/layouts"
import type { IPost } from "@/models"

interface Props {
    className?: string;
    posts: IPost[];
    pinnedPost?: IPost;
}

const { className, posts, pinnedPost } = Astro.props;

if (pinnedPost) {
    pinnedPost.id = "pinned-pinned-pinned-pinned-pinned";
}
---

<SectionLayout className={className} title="Posts">
    <div slot="rightNode" class="flex gap-2 items-center">
        <PostSearch client:idle />
        <PostFilter client:idle />
    </div>
    {pinnedPost && <Post data={pinnedPost} isPinned client:load />}
    {
        posts
            .map((post) => <Post data={post} client:load />)
    }
</SectionLayout>

---
import { Post, PostSearch, PostFilter } from "@/components/feature"
import { SectionLayout } from "@/components/layouts"
import type { IPost } from "@/models"

interface Props {
    className?: string;
    posts: IPost[];
    pinnedPost?: IPost;
    currentPage?: number;
}

const { className, posts, pinnedPost, currentPage = 1 } = Astro.props;

// Se CLONA (antes se mutaba el objeto original, que es el mismo de la lista paginada:
// el post fijado perdía su id real en su propia página y el enlace compartido dejaba de anclar).
const pinned: IPost | undefined = pinnedPost
    ? { ...pinnedPost, id: "pinned-pinned-pinned-pinned-pinned", realId: pinnedPost.id }
    : undefined;
---

<SectionLayout className={className} title={currentPage > 1 ? `Posts (Página ${currentPage})` : "Posts"} headingLevel="h2">
    <div slot="rightNode" class="flex gap-2 items-center">
        <PostSearch client:idle />
        <PostFilter client:idle />
    </div>
    {pinned && <Post data={pinned} isPinned priority initialUnlock={false} client:idle />}
    {
        posts.map((post, index) => {
            const isFirst = index === 0;

            if (isFirst) {
                 return (
                    <Post
                        data={post}
                        priority={true}
                        initialUnlock={false}
                        client:idle
                    />
                )
            }

            return (
                <Post
                    data={post}
                    priority={false}
                    initialUnlock={false}
                    client:visible={{ rootMargin: "200px" }}
                />
            )
        })
    }
</SectionLayout>

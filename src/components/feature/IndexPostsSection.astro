---
import { Post, PostSearch, PostFilter } from "@/components/feature"
import { SectionLayout } from "@/components/layouts"
import type { IPost } from "@/models"

interface Props {
    className?: string;
    posts: IPost[];
    pinnedPost?: IPost;
    currentPage?: number;
}

const { className, posts, pinnedPost, currentPage = 1 } = Astro.props;

if (pinnedPost) {
    pinnedPost.id = "pinned-pinned-pinned-pinned-pinned";
}
---

<SectionLayout className={className} title={currentPage > 1 ? `Posts (Página ${currentPage})` : "Posts"}>
    <div slot="rightNode" class="flex gap-2 items-center">
        <PostSearch client:idle />
        <PostFilter client:idle />
    </div>
    {pinnedPost && <Post data={pinnedPost} isPinned priority initialUnlock={false} client:load />}
    {
        posts.map((post, index) => {
            const isFirst = index === 0; 
            
            if (isFirst) {
                 return (
                    <Post 
                        data={post} 
                        priority={true} 
                        initialUnlock={false}
                        client:load 
                    />
                )
            }

            return (
                <Post 
                    data={post} 
                    priority={false} 
                    initialUnlock={false}
                    client:visible={{ rootMargin: "200px" }} 
                />
            )
        })
    }
</SectionLayout>

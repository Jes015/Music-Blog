---
interface Props {
    className?: string;
}

import { SectionLayout } from "@/components/layouts"
import { getPostsEntries } from "@/utils"
import { Post } from "./Post/Post"

let data = await getPostsEntries("posts");

data = data.filter(post => post.valor)

const { className } = Astro.props;
---

<SectionLayout className={[className, "pb-72"].join(" ")} title="Posts que piensan como yo">
    {
        data
            .sort((a, b) => b.publishDate - a.publishDate)
            .map((post) => <Post data={post} client:load />)
    }
</SectionLayout>

---
import { getPostsEntries } from "@/utils"

// 1. Fetch and calculate the map at build time
const allPosts = await getPostsEntries('posts')
const sortedPosts = allPosts.sort((a, b) => b.publishDate - a.publishDate)
const pageSize = 8

// Create a map of Post ID -> Page Number
const postPageMap: Record<string, number> = {}

sortedPosts.forEach((post, index) => {
    const pageNumber = Math.floor(index / pageSize) + 1
    postPageMap[post.id] = pageNumber
})

const postsMapJSON = JSON.stringify(postPageMap)
---

<script is:inline define:vars={{ postsMapJSON }}>
    document.addEventListener('astro:page-load', () => {
        const hash = window.location.hash.substring(1); // Remove '#'
        if (!hash) return;

        console.log('[PostLocator] Checking for post:', hash);

        // Verify if the element is already on the page
        const element = document.getElementById(hash);
        if (element) {
            console.log('[PostLocator] Element found on current page. Scrolling...');
            element.scrollIntoView({ behavior: 'smooth' });
            return;
        }

        console.log('[PostLocator] Element NOT found. Checking map...');

        // Element NOT found, check the map
        try {
            const map = JSON.parse(postsMapJSON);
            const targetPage = map[hash];

            console.log('[PostLocator] Target Page from map:', targetPage);

            if (targetPage) {
                const targetPath = targetPage === 1 ? '/' : `/${targetPage}`;
                
                console.log(`[PostLocator] Redirecting from ${window.location.pathname} to ${targetPath}#${hash}`);

                // Avoid infinite redirect if we are already on that page but element is missing (weird edge case)
                if (window.location.pathname === targetPath || (targetPage === 1 && window.location.pathname === '/')) {
                    console.warn('[PostLocator] ALREADY ON TARGET PAGE but element not found. Rendering issue?');
                    // Force reload if we are stuck? No, that causes loops if rendering truly fails.
                    return;
                }

                // Redirect
                window.location.href = `${targetPath}#${hash}`;
            } else {
                console.warn('[PostLocator] Post ID not found in map.');
            }
        } catch (e) {
            console.error('[PostLocator] Error parsing map', e);
        }
    });
</script>

---
interface Props {
  page: {
    url: {
      prev: string | undefined;
      next: string | undefined;
    };
    currentPage: number;
    lastPage: number;
  };
}

const { page } = Astro.props;

// Configuration for the pagination window
const SIBLING_COUNT = 1; // How many pages to show on each side of the current page

// Helper to generate the range of numbers
function getPaginationRange(currentPage: number, lastPage: number) {
  const totalNumbers = SIBLING_COUNT * 2 + 5; // sibling + sibling + current + first + last + ellipsis * 2
  const totalBlocks = totalNumbers + 2;

  if (lastPage <= totalBlocks) {
    return Array.from({ length: lastPage }, (_, i) => i + 1);
  }

  const leftSiblingIndex = Math.max(currentPage - SIBLING_COUNT, 1);
  const rightSiblingIndex = Math.min(currentPage + SIBLING_COUNT, lastPage);

  const shouldShowLeftDots = leftSiblingIndex > 2;
  const shouldShowRightDots = rightSiblingIndex < lastPage - 2;

  const firstPageIndex = 1;
  const lastPageIndex = lastPage;

  if (!shouldShowLeftDots && shouldShowRightDots) {
    const leftItemCount = 3 + 2 * SIBLING_COUNT;
    const leftRange = Array.from({ length: leftItemCount }, (_, i) => i + 1);
    return [...leftRange, "...", lastPageIndex];
  }

  if (shouldShowLeftDots && !shouldShowRightDots) {
    const rightItemCount = 3 + 2 * SIBLING_COUNT;
    const rightRange = Array.from({ length: rightItemCount }, (_, i) => lastPage - rightItemCount + i + 1);
    return [firstPageIndex, "...", ...rightRange];
  }

  if (shouldShowLeftDots && shouldShowRightDots) {
    const middleRange = Array.from({ length: rightSiblingIndex - leftSiblingIndex + 1 }, (_, i) => leftSiblingIndex + i);
    return [firstPageIndex, "...", ...middleRange, "...", lastPageIndex];
  }
    
    return []
}

const paginationRange = getPaginationRange(page.currentPage, page.lastPage);
---

<nav class="flex justify-center items-center mt-12 mb-8 w-full max-w-full" aria-label="Pagination">
  <ul class="flex items-center gap-1 sm:gap-2 flex-wrap justify-center max-w-full">
    {/* Previous Button */}
    <li>
      {page.url.prev ? (
        <a
          href={page.url.prev}
          class="flex items-center justify-center w-8 h-8 sm:w-10 sm:h-10 rounded-full border border-neutral-800 bg-neutral-900/50 text-neutral-400 hover:text-white hover:border-neutral-600 hover:bg-neutral-800 transition-all duration-300 group"
          aria-label="Previous Page"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transform group-hover:-translate-x-0.5 transition-transform">
            <path d="m15 18-6-6 6-6"/>
          </svg>
        </a>
      ) : (
        <span class="flex items-center justify-center w-8 h-8 sm:w-10 sm:h-10 rounded-full border border-neutral-900 bg-neutral-950 text-neutral-700 cursor-not-allowed">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"/>
          </svg>
        </span>
      )}
    </li>

    {/* Page Numbers */}
    {paginationRange.map((pageNumber) => {
      if (pageNumber === "...") {
        return (
          <li class="flex items-end justify-center w-6 h-8 sm:w-8 sm:h-10 pb-2">
            <span class="text-neutral-600">...</span>
          </li>
        );
      }

      const isCurrent = pageNumber === page.currentPage;
      // Astro's paginate helper creates URLs like /blog/2, /blog/3. 
      // We need to construct the URL for specific page numbers.
      // Based on inspection, page.url.first is likely the base (e.g., /blog or /blog/1).
      // A robust way often depends on how the [page].astro file sets paths, 
      // but usually `page.url.prev` or `next` gives hints. 
      // However, the `page` prop in Astro typically only gives prev/next/current.
      // THE FIX: The `page` object DOES NOT provide a direct `getUrl(n)` method.
      // We have to infer the URL structure. 
      // Usually: Base URL + `/${number}` (except maybe for 1).
      // Let's assume the current path structure.
      // If we are at `/page/2`, next is `/page/3`.
      // If we are at `/`, next is `/page/2`.
      
      // TRICKY PART: The canonical way to get arbitrary page URL in Astro isn't always direct 
      // without knowing the route pattern.
      // Looking at `src/pages/[...page].astro` implies the route is at root `/` or nested?
      // Wait, `src/pages/[...page].astro` implies it captures everything.
      // If it's the index page, likely `/` for page 1, `/2` for page 2? Or `/page/2`?
      // Let's look at `page.url.first` or `prev` logic again.
      // The safest bet without a helper is to use a relative link logic or string manipulation 
      // if the pattern is consistent.
      // BUT `getStaticPaths` returned `paginate`.
      // `page.url.current` exists.
      
      // Let's try to deduce the base path from `page.url.current`.
      // If `currentPage` is 1, Url is `/`.
      // If `currentPage` is 2, Url is `/2` (if set up that way) or `/page/2`.
      // Inspecting `[...page].astro` again... it's `getStaticPaths`.
      // Standard Astro behavior for `[...page]`:
      // / -> Page 1
      // /2 -> Page 2
      // /3 -> Page 3
      // So the URL for page `n` is just `/${n}`? Or relative?
      
      // Lets assume standard root pagination for now:
      // Page 1 -> `/` (or whatever `page.url.first` is)
      // Page N -> `/${n}`?
      
      // BETTER APPROACH:
      // Use `page.url.first` and `page.url.last` to parse the structure?
      // If `page.url.next` is present and valid, use that pattern?
      
      // Actually, for this specific request, I will check what `page` prop provides.
      // It provides `url` object with prev/next.
      // It DOES NOT standardly provide a function for arbitrary pages.
      // I will implement a simpler heuristic:
      // Use the `page.url.current` and replace the page number? No, `current` is path.
      
      // Let's assume the pattern `/${pageNumber}` for root, but check if `page.url.prev` exists.
      // If `currentPage` is 2, `prev` is likely `/` or `/1`.
      // Let's assume the user has a standard setup.
      // I will try to be safe: 
      // Use `${pageNumber === 1 ? '/' : '/' + pageNumber}` ?
      // Wait, `[...page]` acts as a catch-all. 
      // If the file is `src/pages/[...page].astro`, it handles `/` and `/2`, `/3` etc. directly.
      // So `href={`/${pageNumber === 1 ? '' : pageNumber}`}` should work IF the blog is at root.
      // Checking `[...page].astro` again... it imports `MainLayout` and `IndexPostsSection`.
      // It seems to be the main home page. 
      
      // Infer the base path from the current URL
      const currentPath = Astro.url.pathname.replace(/\/+$/, "");
      // Remove the last segment if it is a number (the current page)
      const basePath = currentPath.replace(/\/\d+$/, "");

      let href = pageNumber === 1 
        ? (basePath || "/") 
        : `${basePath === "/" ? "" : basePath}/${pageNumber}`;

      return (
        <li>
          <a
            href={href}
            class:list={[
              "flex items-center justify-center w-8 h-8 sm:w-10 sm:h-10 rounded-full text-xs sm:text-sm font-medium transition-all duration-300",
              isCurrent
                ? "bg-white text-black shadow-[0_0_15px_rgba(255,255,255,0.3)] scale-110"
                : "text-neutral-400 hover:bg-neutral-800 hover:text-white border border-transparent hover:border-neutral-700"
            ]}
            aria-current={isCurrent ? "page" : undefined}
          >
            {pageNumber}
          </a>
        </li>
      );
    })}

    {/* Next Button */}
    <li>
      {page.url.next ? (
        <a
          href={page.url.next}
          class="flex items-center justify-center w-8 h-8 sm:w-10 sm:h-10 rounded-full border border-neutral-800 bg-neutral-900/50 text-neutral-400 hover:text-white hover:border-neutral-600 hover:bg-neutral-800 transition-all duration-300 group"
          aria-label="Next Page"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transform group-hover:translate-x-0.5 transition-transform">
            <path d="m9 18 6-6-6-6"/>
          </svg>
        </a>
      ) : (
        <span class="flex items-center justify-center w-8 h-8 sm:w-10 sm:h-10 rounded-full border border-neutral-900 bg-neutral-950 text-neutral-700 cursor-not-allowed">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m9 18 6-6-6-6"/>
          </svg>
        </span>
      )}
    </li>
  </ul>
</nav>

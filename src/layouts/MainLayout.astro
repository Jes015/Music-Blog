---
import '@fontsource/geist-sans/400.css'
import '@fontsource/geist-sans/500.css'
import '@fontsource/geist-sans/600.css'
import '@fontsource/geist-sans/700.css'
import { ViewTransitions } from 'astro:transitions'
import Galaxy from '@/components/Galaxy'
import { DEFAULT_DESCRIPTION, DEFAULT_TITLE, FEED, PERSON, SITE_LOCALE, SITE_NAME, SOCIAL_LINKS, THEME_COLOR } from '@/consts'
import { breadcrumbNode, canonicalFrom, routeSeoDefaults, toAbsolute, type BreadcrumbItem, type JsonLd } from '@/utils/seo.util'

interface OgImage {
    src: string
    width?: number
    height?: number
    alt?: string
}

interface Props {
    title?: string
    description?: string
    jsonLd?: JsonLd | JsonLd[]
    image?: OgImage
    type?: 'website' | 'article'
    noindex?: boolean
    publishedTime?: string
    breadcrumbs?: BreadcrumbItem[]
    // Páginas que no he visto podrían pasar otras props: no rompemos astro check por eso.
    [key: string]: unknown
}

const { title, description, jsonLd, image, type = 'website', noindex, publishedTime, breadcrumbs } = Astro.props

const site = Astro.site ?? new URL(Astro.url.origin)
const route = routeSeoDefaults(Astro.url.pathname)

const pageTitle = title ?? route?.title ?? DEFAULT_TITLE
const pageDescription = description ?? route?.description ?? DEFAULT_DESCRIPTION
const robotsNoIndex = noindex ?? route?.noindex ?? false
const crumbs = breadcrumbs ?? route?.breadcrumbs

const canonical = canonicalFrom(Astro.url.pathname, site)
const og = image ?? { src: '/og/default.png', width: 1200, height: 630, alt: pageTitle }
const ogImageUrl = toAbsolute(og.src, site)
const ogAlt = og.alt ?? pageTitle

// JSON-LD: un único @graph por página (sin @context anidado) + BreadcrumbList si aplica.
const nodes: JsonLd[] = []
for (const node of Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []) {
    const { '@context': _ctx, ...rest } = node
    nodes.push(rest)
}
if (crumbs?.length) nodes.push(breadcrumbNode(crumbs, site))
const jsonLdString = nodes.length
    ? JSON.stringify({ '@context': 'https://schema.org', '@graph': nodes }).replace(/</g, '\\u003c')
    : undefined
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<link rel="canonical" href={canonical} />
		{robotsNoIndex
			? <meta name="robots" content="noindex,follow" />
			: <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />}
		<meta name="author" content={PERSON.name} />
		<meta name="theme-color" content={THEME_COLOR} />
		<meta name="color-scheme" content="dark" />

		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/icons/48.png" sizes="48x48" type="image/png" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/icons/180.png" />
		<link rel="alternate" type="application/rss+xml" title={FEED.title} href={toAbsolute('/rss.xml', site)} />
		<link rel="me" href={SOCIAL_LINKS.instagram} />
		<link rel="me" href={SOCIAL_LINKS.youtube} />
		<link rel="me" href={SOCIAL_LINKS.linkedin} />
		<link rel="me" href={SOCIAL_LINKS.musicbrainz} />
		<link rel="me" href="https://papi.click/" />

		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:locale" content={SITE_LOCALE} />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImageUrl} />
		{og.width && <meta property="og:image:width" content={String(og.width)} />}
		{og.height && <meta property="og:image:height" content={String(og.height)} />}
		<meta property="og:image:alt" content={ogAlt} />
		{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
		{type === 'article' && <meta property="article:author" content={toAbsolute('/', site)} />}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={ogAlt} />

		{jsonLdString && <script type="application/ld+json" set:html={jsonLdString} />}
		<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
		<ViewTransitions />
	</head>
	<body class="bg-neutral-900 text-white overflow-x-hidden">
		<a
			href="#contenido"
			class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:rounded focus:bg-white focus:px-3 focus:py-2 focus:text-sm focus:text-black"
		>Saltar al contenido</a>

		<div class="flex flex-col items-center overflow-x-hidden w-full">
            <div aria-hidden="true" class="fixed top-0 left-0 w-full h-full -z-10 bg-neutral-900">
                <Galaxy
                    client:only="react"
                    mouseInteraction={true}
                    mouseRepulsion={true}
                    density={1}
                    glowIntensity={0.3}
                    saturation={0}
                    hueShift={140}
                    twinkleIntensity={0.3}
                    rotationSpeed={0.001}
                    repulsionStrength={2}
                    autoCenterRepulsion={0}
                    starSpeed={0.01}
                    speed={0.5}
                />
            </div>

			<div class="z-50 [width:96vw] sm:[width:60vw] md:[width:55vw] lg:[width:40vw] xl:[width:35vw] 2xl:[width:30vw]">
				<main id="contenido" tabindex="-1" class="focus:outline-none">
					<slot />
				</main>
                <footer class="w-full text-xs text-neutral-400 mt-10 mb-8 flex flex-col items-center gap-1.5 text-center px-2">
                    <span class="flex items-center gap-2">
                        <a href="/jesus-oyola/" class="underline hover:text-neutral-200">Sobre Jesús Oyola</a>
                        <span aria-hidden="true">·</span>
                        <a href="/posts/" class="underline hover:text-neutral-200">Todos los posts</a>
                    </span>
                    <span class="flex items-center gap-2">
                        <a href={SOCIAL_LINKS.instagram} rel="me" class="underline hover:text-neutral-200">Instagram</a>
                        <span aria-hidden="true">·</span>
                        <a href={SOCIAL_LINKS.youtube} rel="me" class="underline hover:text-neutral-200">YouTube</a>
                        <span aria-hidden="true">·</span>
                        <a href={SOCIAL_LINKS.linkedin} rel="me" class="underline hover:text-neutral-200">LinkedIn</a>
                    </span>
                    <a href="https://papi.click/" class="underline hover:text-neutral-200">
                        Papi Notifications — avisos de anime, series y fútbol a tu WhatsApp o Telegram
                    </a>
                </footer>
			</div>
		</div>

	<script>
		// Script empaquetado (se ejecuta una sola vez, también con ViewTransitions).
		document.addEventListener('astro:page-load', async () => {
			const { pathname, hash: rawHash } = window.location
			let hash = rawHash.slice(1)
			try { hash = decodeURIComponent(hash) } catch { /* hash malformado */ }

			// 1) Páginas paginadas o /destacados: baja al inicio de la lista (si no hay enlace profundo).
			const isPaginated = (pathname !== '/' && /\/\d+\/?$/.test(pathname)) || pathname.includes('/destacados')
			const postsTop = document.getElementById('posts-top')
			if (isPaginated && postsTop && !hash) {
				postsTop.scrollIntoView({ behavior: 'smooth', block: 'start' })
			}

			// 2) Enlace profundo a un post: si no está en esta página, lo buscamos en el mapa (se pide solo cuando hace falta).
			if (!hash) return
			const element = document.getElementById(hash)
			if (element) {
				element.scrollIntoView({ behavior: 'smooth' })
				return
			}
			if (!/^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i.test(hash)) return

			try {
				const response = await fetch('/api/post-map.json')
				if (!response.ok) return
				const map: Record<string, number> = await response.json()
				const targetPage = map[hash]
				if (!targetPage) return
				const target = targetPage === 1 ? '/' : `/${targetPage}/`
				const here = pathname.replace(/\/+$/, '') || '/'
				if (here === (target.replace(/\/+$/, '') || '/')) return
				window.location.href = `${target}#${hash}`
			} catch {
				/* sin red: no pasa nada */
			}
		})
	</script>
	</body>
</html>

<style>
	body {
		font-family: "Geist Sans", system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
	}
</style>

---
import IndexPostsSection from "@/components/feature/IndexPostsSection.astro"
import JOyolaBabyTheLegend from "@/components/feature/JOyolaBabyTheLegend.astro"
import MainLayout from "@/layouts/MainLayout.astro"
import Pagination from "@/components/ui/Pagination.astro"
import "@/styles/global.styles.css"
import { getPostsEntries } from "@/utils"
import type { GetStaticPaths } from "astro"
import type { IPost } from "@/models"

export const getStaticPaths = (async ({ paginate }) => {
    const allPosts = await getPostsEntries('posts')
    const sortedPosts = allPosts.sort((a, b) => b.publishDate - a.publishDate)
    
	const pinnedPost = allPosts.find((post) => post.id === "6e12f930-fd57-4f7d-a653-abfe3a60c0ff")

    return paginate(sortedPosts, { pageSize: 8, props: { pinnedPost } })
}) satisfies GetStaticPaths

const { page, pinnedPost } = Astro.props

// Person (solo en la portada): refuerza la entidad "Jesús Oyola" para Google.
const personLd = page.currentPage === 1
    ? {
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: 'Jesús Oyola',
        alternateName: ['J Oyola', 'JOyola'],
        url: new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString(),
        sameAs: [
            'https://www.instagram.com/jesus.oyola.15',
            'https://www.youtube.com/@jesus.oyola.15',
        ],
    }
    : undefined
---

<MainLayout
    title={page.currentPage === 1 ? 'Jesús Oyola — Música, beats y blog personal' : `Jesús Oyola — Blog (página ${page.currentPage})`}
    jsonLd={personLd}
>
	<JOyolaBabyTheLegend />
	<div class="flex flex-col">
		<IndexPostsSection posts={page.data} pinnedPost={page.currentPage === 1 ? pinnedPost as IPost : undefined} currentPage={page.currentPage} className="flex-shrink-0 flex-grow [flex-basis:100%]" />
        
        <Pagination page={page} />
	</div>
</MainLayout>

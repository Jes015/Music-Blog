---
import JesusOyolaSection from "@/components/feature/JesusOyolaSection.astro"
import MainLayout from "@/layouts/MainLayout.astro"
import "@/styles/global.styles.css"
import { canonicalFrom, personId, personNode, websiteId } from "@/utils/seo.util"

// Página-entidad de la marca personal: ProfilePage + Person (misma ficha que en toda la web).
const site = Astro.site ?? new URL(Astro.url.origin)
const pageUrl = canonicalFrom(Astro.url.pathname, site)

const jsonLd = [
    {
        '@type': 'ProfilePage',
        '@id': `${pageUrl}#profilepage`,
        url: pageUrl,
        name: 'Quién es Jesús Oyola',
        inLanguage: 'es',
        isPartOf: { '@id': websiteId(site) },
        mainEntity: { '@id': personId(site) },
    },
    personNode(site),
]
---

<MainLayout
    title="Quién es Jesús Oyola — músico y beatmaker de Montería"
    description="Página oficial de Jesús Oyola, músico y beatmaker de Montería, Colombia: quién es, su música, sus beats, sus proyectos y su blog personal."
    jsonLd={jsonLd}
    breadcrumbs={[
        { name: 'Inicio', path: '/' },
        { name: 'Sobre Jesús Oyola', path: '/jesus-oyola/' },
    ]}
>
    <header class="w-full px-2 pt-6">
        <a href="/" class="text-xs text-neutral-400 hover:text-neutral-200">← Volver al blog</a>
        <h1 class="mt-2 font-bold text-xl underline decoration-wavy decoration-zinc-50">Jesús Oyola</h1>
        <p class="mt-2 text-sm text-neutral-300 leading-6">
            Músico y beatmaker de Montería, Colombia: canciones, beats, metas y todo lo que voy escribiendo en el camino.
        </p>
    </header>
    <JesusOyolaSection />
</MainLayout>

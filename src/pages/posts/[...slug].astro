---
import { getCollection } from 'astro:content'
import MainLayout from '@/layouts/MainLayout.astro'

export async function getStaticPaths() {
  const posts = await getCollection('posts')
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props as { entry: any }
const { title, content, publishDate, images, spotifyUrl } = entry.data

const plain = String(content ?? '')
  .replace(/<br\s*\/?>/gi, ' ')
  .replace(/<[^>]*>/g, ' ')
  .replace(/&nbsp;/g, ' ')
  .replace(/&amp;/g, '&')
  .replace(/\s+/g, ' ')
  .trim()
const description = plain.slice(0, 155)

const dateFmt = new Intl.DateTimeFormat('es-CO', {
  dateStyle: 'long',
  timeZone: 'America/Bogota',
}).format(new Date(publishDate))
const isoDate = new Date(publishDate).toISOString()
---

<MainLayout title={`${title} — J Oyola`} description={description}>
  <article class="w-full px-2 pt-6 pb-4 flex flex-col gap-3">
    <a href="/" class="text-xs text-neutral-400 hover:text-neutral-200">← Volver al blog</a>

    <header class="flex flex-col gap-1">
      <h1 class="text-xl font-semibold leading-snug">{title}</h1>
      <time datetime={isoDate} class="text-xs text-neutral-400">{dateFmt}</time>
    </header>

    {images?.length ? (
      <div class="flex flex-col gap-2">
        {images.map((image: any) => (
          <img src={image.src} alt={title} loading="lazy" decoding="async" width="100%" class="rounded-md" />
        ))}
      </div>
    ) : null}

    {spotifyUrl ? (
      <iframe
        style="border-radius: 12px"
        src={spotifyUrl}
        width="100%"
        height="80"
        title="Spotify Player"
        allowfullscreen
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        loading="lazy"
      />
    ) : null}

    <div class="text-sm leading-6 text-neutral-200 [&_a]:text-blue-300 [&_a]:underline" set:html={content} />

    <footer class="mt-4 pt-4 border-t border-neutral-400/10 flex flex-col gap-2 text-xs text-neutral-400">
      <a href="/posts" class="underline hover:text-neutral-200">Ver todos los posts</a>
      <a href="https://papi.click/alertas/anime?ref=blog" class="underline hover:text-neutral-200">
        Papi Notifications — avisos de anime, series y fútbol a tu WhatsApp o Telegram
      </a>
    </footer>
  </article>
</MainLayout>

---
import { SITE_NAME } from '@/consts'
import MainLayout from '@/layouts/MainLayout.astro'
import { canonicalFrom, isTestEntry, toAbsolute, websiteId } from '@/utils/seo.util'
import { getCollection } from 'astro:content'

const posts = (await getCollection('posts'))
  .filter((post) => !isTestEntry(post.id))
  .sort((a, b) => b.data.publishDate - a.data.publishDate)

const site = Astro.site ?? new URL(Astro.url.origin)
const pageUrl = canonicalFrom(Astro.url.pathname, site)
const dateFmt = new Intl.DateTimeFormat('es-CO', { dateStyle: 'medium', timeZone: 'America/Bogota' })

const title = `Todos los posts del blog — ${SITE_NAME}`
const description = `Archivo completo del blog de música de ${SITE_NAME}: ${posts.length} posts con historias, pensamientos y canciones, del más reciente al más antiguo.`

const jsonLd = {
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#collection`,
  url: pageUrl,
  name: `Todos los posts del blog de ${SITE_NAME}`,
  description,
  inLanguage: 'es',
  isPartOf: { '@id': websiteId(site) },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: posts.length,
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    itemListElement: posts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: toAbsolute(`/posts/${post.id}/`, site),
    })),
  },
}
---

<MainLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  breadcrumbs={[
    { name: 'Inicio', path: '/' },
    { name: 'Posts', path: '/posts/' },
  ]}
>
  <section class="w-full px-2 pt-6 pb-4">
    <a href="/" class="text-xs text-neutral-400 hover:text-neutral-200">← Volver al blog</a>
    <h1 class="mt-2 text-xl font-semibold">Todos los posts</h1>
    <ul class="mt-4 flex flex-col divide-y divide-neutral-400/10">
      {posts.map((post) => (
        <li>
          <a href={`/posts/${post.id}/`} class="flex items-baseline justify-between gap-4 py-2.5 group">
            <span class="text-sm text-neutral-200 group-hover:text-white group-hover:underline leading-snug">
              {post.data.title}
            </span>
            <time datetime={new Date(post.data.publishDate).toISOString()} class="shrink-0 text-[11px] text-neutral-500">
              {dateFmt.format(new Date(post.data.publishDate))}
            </time>
          </a>
        </li>
      ))}
    </ul>
  </section>
</MainLayout>
